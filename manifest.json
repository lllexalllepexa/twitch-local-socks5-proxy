{
  "manifest_version": 3,
  "name": "Twitch Throne Proxy",
  "version": "1.0.0",
  "description": "Route Twitch traffic through local Throne SOCKS5 proxy",
  "permissions": [
    "proxy",
    "storage"
  ],
  "host_permissions": [
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}